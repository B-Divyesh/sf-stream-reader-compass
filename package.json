{
  "name": "stream-reader-compass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts --host 127.0.0.1 --port 4173",
    "dev:extension": "wxt",
    "build:extension": "wxt build",
    "assets": "node scripts/optimize-assets.mjs",
    "build:site": "npm run assets && vite build --config site/vite.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "npm run build:extension && npm run package:extension && npm run build:site",
    "test": "playwright test",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "wxt prepare && tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.326",
    "archiver": "7.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  }
}
